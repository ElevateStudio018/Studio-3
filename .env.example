# Kopiera till .env (eller sätt som miljövariabler hos ert webbhotell)
PORT=3000
SITE_URL=https://studio3.se
ADMIN_EMAIL=admin@studio3.se
ADMIN_PASSWORD=byt-till-ett-langt-losenord
COOKIE_SECURE=1
IP_SALT=slumpa-en-lang-strang-har

# E-post via Resend (https://resend.com). Utan nyckel hamnar alla mejl i admin > Utkorg.
RESEND_API_KEY=
MAIL_FROM="STUDIO 3 <debatt@studio3.se>"
NOTIFY_EMAIL=

# YouTube. Utan API-nyckel används kanalens öppna RSS-flöde för nya videor.
YOUTUBE_CHANNEL_ID=UCq0WPjQ9K4beFTYSQFx_rSQ
YOUTUBE_API_KEY=
YOUTUBE_SYNC_MINUTES=30

# Sätt till 0 för att inte skapa exempeldebatter vid första start
SEED_SAMPLE_DEBATES=1
